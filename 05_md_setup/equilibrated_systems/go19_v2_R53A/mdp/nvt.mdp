; NVT equilibration -- 500 ps, 300 K, position restraints k=1000
integrator          = md
nsteps              = 250000
dt                  = 0.002
nstxout-compressed  = 500
nstenergy           = 500
nstlog              = 500
continuation        = no
constraint_algorithm= lincs
constraints         = h-bonds
lincs_iter          = 1
lincs_order         = 4
cutoff-scheme       = Verlet
nstlist             = 10
ns_type             = grid
coulombtype         = PME
rcoulomb            = 1.0
pme_order           = 4
fourierspacing      = 0.16
rvdw                = 1.0
tcoupl              = V-rescale
tc-grps             = System
tau_t               = 0.1
ref_t               = 300
pcoupl              = no
pbc                 = xyz
DispCorr            = EnerPres
gen_vel             = yes
gen_temp            = 300
gen_seed            = -1
define              = -DPOSRES
